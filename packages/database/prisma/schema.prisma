datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  PERSONAL
}

enum Shift {
  MANANA
  TARDE
  NOCHE
  ROTATIVO
}

model User {
  id                  String       @id @default(cuid())
  username            String       @unique
  fullName            String
  ci                  String       @unique
  phone               String
  email               String?
  passwordHash        String
  role                UserRole     @default(PERSONAL)
  shift               Shift        @default(MANANA)
  canApplyPromotions  Boolean      @default(false)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  ordersCreated       Order[]
  reportsGenerated    PatientReport[]

  @@index([role, isActive])
}

model Patient {
  id          String   @id @default(cuid())
  fullName    String
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([fullName])
}

model AssociatedDoctor {
  id                String             @id @default(cuid())
  fullName          String
  hospitalOrClinic  String?
  agreedCommission  Decimal            @db.Decimal(10, 2)
  phone             String
  email             String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  orders            Order[]
  commissions       DoctorCommission[]

  @@index([fullName, isActive])
}

enum ServiceType {
  HACER_ECOGRAFIA
  SOLO_INFORME
}

enum ReportCategory {
  ECOGRAFIA
  TOMOGRAFIA
}

model StudyService {
  id              String          @id @default(cuid())
  name            String
  serviceType     ServiceType
  reportCategory  ReportCategory?
  normalPrice     Decimal         @db.Decimal(10, 2)
  promoPrice      Decimal         @db.Decimal(10, 2)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orderItems      OrderItem[]
  reportFormats   ReportFormat[]

  @@index([serviceType, isActive])
}

model ReportFormat {
  id              String         @id @default(cuid())
  name            String
  studyServiceId  String
  studyService    StudyService   @relation(fields: [studyServiceId], references: [id])
  documentHtml    String         @db.Text
  boundingBoxes   Json           
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  patientReports  PatientReport[]

  @@index([studyServiceId])
}

enum OrderOrigin {
  POR_SU_CUENTA
  RECOMENDACION
  PROMOCION
}

enum OrderStatus {
  EN_ESPERA
  EN_ATENCION
  ATENDIDO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  QR
  MIXTO
  POR_COMPROMISO
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  patientId             String
  patient               Patient           @relation(fields: [patientId], references: [id])
  createdById           String
  createdBy             User              @relation(fields: [createdById], references: [id])
  origin                OrderOrigin       @default(POR_SU_CUENTA)
  associatedDoctorId    String?
  associatedDoctor      AssociatedDoctor? @relation(fields: [associatedDoctorId], references: [id])
  isEmergency           Boolean           @default(false)
  emergencySurcharge    Decimal           @default(0.00) @db.Decimal(10, 2)
  queuePriority         Int               @default(0)
  status                OrderStatus       @default(EN_ESPERA)
  subtotalStudies       Decimal           @db.Decimal(10, 2)
  totalAmount           Decimal           @db.Decimal(10, 2)
  paymentMethod         PaymentMethod
  amountCash            Decimal           @default(0.00) @db.Decimal(10, 2)
  amountQr              Decimal           @default(0.00) @db.Decimal(10, 2)
  isCommitmentPaid      Boolean           @default(false)
  commitmentPaidAt      DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  items                 OrderItem[]
  commission            DoctorCommission?

  @@index([status, queuePriority])
  @@index([paymentMethod, isCommitmentPaid])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studyServiceId  String
  studyService    StudyService    @relation(fields: [studyServiceId], references: [id])
  priceApplied    Decimal         @db.Decimal(10, 2)

  patientReport   PatientReport?

  @@index([orderId])
}

enum CommissionStatus {
  PENDIENTE
  PAGADA
}

model DoctorCommission {
  id                  String             @id @default(cuid())
  associatedDoctorId  String
  associatedDoctor    AssociatedDoctor   @relation(fields: [associatedDoctorId], references: [id])
  orderId             String             @unique
  order               Order              @relation(fields: [orderId], references: [id])
  amount              Decimal            @db.Decimal(10, 2)
  status              CommissionStatus   @default(PENDIENTE)
  paidAt              DateTime?
  createdAt           DateTime           @default(now())

  @@index([associatedDoctorId, status])
  @@index([createdAt])
}

model PatientReport {
  id              String          @id @default(cuid())
  orderItemId     String          @unique
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id])
  formatId        String
  format          ReportFormat    @relation(fields: [formatId], references: [id])
  generatedById   String
  generatedBy     User            @relation(fields: [generatedById], references: [id])
  fieldValues     Json            
  pdfUrl          String?
  createdAt       DateTime        @default(now())

  @@index([generatedById])
}
